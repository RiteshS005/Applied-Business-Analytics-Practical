#Import Required Libraries
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

#Load dataset
df = pd.read_csv("games.csv")

print(df["Genre"].value_counts())
df["Genre"].value_counts().plot(kind="bar")
plt.title("Genre Analysis")
plt.xlabel("Genre")
plt.ylabel("Number of Games")
plt.show()

print(df["Platform"].value_counts())
df["Platform"].value_counts().plot(kind="bar")
plt.title("Platform Analysis")
plt.xlabel("Platform")
plt.ylabel("Number of Games")
plt.show()

print(df["Year"].value_counts())
df["Year"].value_counts().plot(kind="bar")
plt.title("Games by Year")
plt.xlabel("Year")
plt.ylabel("Number of Games")
plt.show()

print(df["Region"].value_counts())
df["Region"].value_counts().plot(kind="pie", autopct="%1.1f%%")
plt.title("Region")
plt.ylabel("")
plt.show()

plt.hist(df["Global_Sales"], bins=10)
plt.title("Global Sales Distribution")
plt.xlabel("Global Sales")
plt.ylabel("Frequency")
plt.show()

plt.hist(df["NA_Sales"], bins=10)
plt.title("NA Sales Distribution")
plt.xlabel("NA Sales")
plt.ylabel("Frequency")
plt.show()

plt.scatter(df["NA_Sales"], df["Global_Sales"])
plt.title("NA Sales vs Global Sales")
plt.xlabel("NA Sales")
plt.ylabel("Global Sales")
plt.show()

sns.heatmap(df.corr(numeric_only=True), annot=True, cmap="Oranges")
plt.title("Correlation Heatmap")
plt.show()
