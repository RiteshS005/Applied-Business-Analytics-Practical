# TV Shows
tv_director = (
    df[df["type"] == "TV Show"]["director"]
    .dropna()
    .str.split(",")
    .explode()
    .str.strip()
)

tv_count = tv_director.value_counts()

print("\nDirector with Highest TV Shows")
print(tv_count.idxmax(), "-", tv_count.max())

print("\nTop 10 Directors")
print(movie_count.head(10))

# Bar Chart
movie_count.head(10).plot(kind="bar", color="green")
plt.title("Top 10 Directors(Ritesh Chaubey)")
