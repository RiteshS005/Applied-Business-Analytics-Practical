import seaborn as sns
import pandas as pd
import matplotlib.pyplot as plt

df = pd.read_csv("NetFlix - NetFlix.csv")

# Split multiple genres
genre = df["genres"].dropna().str.split(",")

# Convert list into rows
genre = genre.explode().str.strip()

genre_count = genre.value_counts()

print("Top 10 Genres")
print(genre_count.head(10))

print("\nBottom 10 Genres")
print(genre_count.tail(10))

print("\nMost Popular Genre")
print(genre_count.idxmax(), "-", genre_count.max())

print("\nLeast Popular Genre")
print(genre_count.idxmin(), "-", genre_count.min())

# Bar Chart
genre_count.head(10).plot(kind="bar", color="skyblue")
plt.title("Top 10 Genres(Ritesh Chaubey)")
plt.xlabel("Genres")
plt.ylabel("Number of Titles")
plt.xticks(rotation=45)
plt.show()
movies = df[df["type"] == "Movie"]
print("Oldest Movie")
print(movies.loc[movies["release_year"].idxmin()])

print("\nNewest Movie")
print(movies.loc[movies["release_year"].idxmax()])
tvshows = df[df["type"] == "TV Show"]
print("\nOldest TV Show")
print(tvshows.loc[tvshows["release_year"].idxmin()])

print("\nNewest TV Show")
print(tvshows.loc[tvshows["release_year"].idxmax()])
country = df["country"].dropna().str.split(",")

country = country.explode().str.strip()

country_count = country.value_counts()

print("Country with Highest Netflix Content")
print(country_count.idxmax(), "-", country_count.max())

print("\nTop 10 Countries")
print(country_count.head(10))

print("\nBottom 10 Countries")
print(country_count.tail(10))

# Horizontal Bar Chart
country_count.head(10).sort_values().plot(kind="barh", color="orange")
plt.title("Top 10 Countries(Ritesh Chaubey)")
plt.xlabel("Number of Titles")
plt.ylabel("Country")
plt.show()
# Movies
movie_director = (
    df[df["type"] == "Movie"]["director"]
    .dropna()
